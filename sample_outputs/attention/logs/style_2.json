{
    "version": 1,
    "layout_type": "two-column layout: architecture diagram left, bullets and equation right",
    "layout_tags": [
        "two_col",
        "figure_left",
        "method",
        "architecture"
    ],
    "layout_signature": "T|D-B",
    "background_color": "#FFFFFF",
    "elements": [
        {
            "id": "title",
            "type": "T",
            "content_ref": "elements.title",
            "box": {
                "tl": "B01",
                "br": "U03"
            },
            "style": {
                "font_size": 36,
                "bold": true,
                "align": "left"
            }
        },
        {
            "id": "architecture_diagram",
            "type": "D",
            "content_ref": "elements.figure",
            "box": {
                "tl": "B04",
                "br": "L19"
            },
            "constraints": {
                "keep_aspect": true
            }
        },
        {
            "id": "description_bullets",
            "type": "B",
            "content_ref": "elements.bullets",
            "box": {
                "tl": "M04",
                "br": "T14"
            },
            "style": {
                "font_size": 22
            }
        },
        {
            "id": "normalization_eq",
            "type": "EQ",
            "content_ref": "elements.equations",
            "box": {
                "tl": "M15",
                "br": "T19"
            },
            "style": {
                "font_size": 20
            }
        }
    ],
    "global_constraints": {
        "no_overlap": true,
        "no_overflow": true,
        "min_font_size": 14
    }
}