{
    "version": 1,
    "layout_type": "wide table top, bullets and equation bottom",
    "layout_tags": [
        "training",
        "hyperparameters",
        "table_top",
        "two_col_bottom"
    ],
    "layout_signature": "T|ST|TAB|B-EQ",
    "background_color": "#FFFFFF",
    "elements": [
        {
            "id": "title",
            "type": "T",
            "content_ref": "elements.title",
            "box": {
                "tl": "B01",
                "br": "U02"
            },
            "style": {
                "font_size": 36,
                "bold": true,
                "align": "left"
            }
        },
        {
            "id": "subtitle",
            "type": "ST",
            "content_ref": "elements.subtitle",
            "box": {
                "tl": "B02",
                "br": "U03"
            },
            "style": {
                "font_size": 24,
                "align": "left"
            }
        },
        {
            "id": "table",
            "type": "TAB",
            "content_ref": "elements.figure",
            "box": {
                "tl": "B04",
                "br": "T14"
            },
            "constraints": {
                "keep_aspect": true
            }
        },
        {
            "id": "bullets",
            "type": "B",
            "content_ref": "elements.bullets",
            "box": {
                "tl": "B15",
                "br": "L19"
            },
            "style": {
                "font_size": 20,
                "min_font_size": 16
            }
        },
        {
            "id": "equation",
            "type": "EQ",
            "content_ref": "elements.equations",
            "box": {
                "tl": "M15",
                "br": "T19"
            }
        }
    ],
    "global_constraints": {
        "no_overlap": true,
        "no_overflow": true,
        "min_font_size": 14
    }
}