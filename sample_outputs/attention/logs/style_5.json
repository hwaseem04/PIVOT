{
    "version": 1,
    "layout_type": "two-column layout: architecture diagram left, bullets right, equations top",
    "layout_tags": [
        "two_col",
        "architecture_left",
        "method",
        "equations",
        "positional_encoding"
    ],
    "layout_signature": "T|ST|EQ|D-B",
    "background_color": "#FFFFFF",
    "elements": [
        {
            "id": "title",
            "type": "T",
            "content_ref": "elements.title",
            "box": {
                "tl": "B01",
                "br": "U02"
            },
            "style": {
                "font_size": 36,
                "bold": true,
                "align": "left"
            }
        },
        {
            "id": "subtitle",
            "type": "ST",
            "content_ref": "elements.subtitle",
            "box": {
                "tl": "B03",
                "br": "U04"
            },
            "style": {
                "font_size": 24,
                "italic": true,
                "align": "left"
            }
        },
        {
            "id": "equations",
            "type": "EQ",
            "content_ref": "elements.equations",
            "box": {
                "tl": "B05",
                "br": "U07"
            },
            "style": {
                "font_size": 28,
                "align": "center"
            }
        },
        {
            "id": "architecture",
            "type": "D",
            "content_ref": "elements.figure",
            "box": {
                "tl": "B08",
                "br": "L19"
            },
            "constraints": {
                "keep_aspect": true
            }
        },
        {
            "id": "bullets",
            "type": "B",
            "content_ref": "elements.bullets",
            "box": {
                "tl": "M08",
                "br": "T19"
            },
            "style": {
                "font_size": 24,
                "min_font_size": 16
            }
        }
    ],
    "global_constraints": {
        "no_overlap": true,
        "no_overflow": true,
        "min_font_size": 14
    }
}